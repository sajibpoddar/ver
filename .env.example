# These are auto-populated by Vercel when you connect a KV/Redis store
# to this project (Storage tab -> Create Database -> KV). You don't need
# to set them by hand on Vercel. For local dev, copy this to .env.local
# and fill in the values shown in the store's ".env.local" tab.

KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
